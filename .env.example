# LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=90
GEMINI_MAX_RETRIES=3

# Engine selection
# auto   = Gemini if a key is set, otherwise the rules engine (loudly, never silently)
# gemini = Gemini only; fail non-zero if unavailable or its output fails grounding
# rules  = deterministic rules engine, no network
ENGINE=auto

# REST API
HOST=127.0.0.1
PORT=8000
# If set, every /api/v1 call must send this value in the X-API-Key header.
API_KEY=

# Comma-separated allowed CORS origins. Empty = CORS disabled.
CORS_ORIGINS=
MAX_BODY_BYTES=2000000
LOG_LEVEL=INFO
